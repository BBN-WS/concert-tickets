# Copy to .env (local) or set these in the Vercel project settings.
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection used by Prisma for db push / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Required by NextAuth in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# The canonical URL of the deployment (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"
